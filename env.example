# Copy to lab.env and edit. build.sh and guest-exec.sh source this file.
# Lab credentials only. Do not put real secrets here.

# --- libvirt ---------------------------------------------------------------
LIBVIRT_URI=qemu:///system
NET=mld-lab
POOL=mld
# All VM data lives in the repo. data/ is in .gitignore. $HERE is the repo root (set by build.sh).
# The qemu user must be able to enter each parent directory: ./build.sh check tests this.
DATA_DIR=$HERE/data
POOL_DIR=$DATA_DIR/pool

# --- media (checked against checksums.sha256) -------------------------------
# Client OS: ubuntu (26.04) or fedora (45). One distro per client VM: to change it, build the client again.
CLIENT_DISTRO=ubuntu
# Identity server in the dc role: windows (Server 2025 AD DS + AD CS) or freeipa (FreeIPA on Fedora 45, no Microsoft software).
# One identity server per lab: to change it, build the DC and the client again.
IDP=windows

# Ubuntu has a published SHA256SUMS. Windows and virtio-win do not: ./build.sh pin records them at first download.
# Fedora publishes a signed CHECKSUM file: it is checked when fedora.gpg is in MEDIA_DIR.
MEDIA_DIR=$DATA_DIR/media
WINSERVER_ISO=$MEDIA_DIR/winserver2025-eval.iso
VIRTIO_ISO=$MEDIA_DIR/virtio-win-0.1.302.iso
UBUNTU_ISO=$MEDIA_DIR/ubuntu-26.04.1-live-server-amd64.iso
WINSERVER_URL='https://go.microsoft.com/fwlink/?linkid=2293312&clcid=0x409&culture=en-us&country=us'
VIRTIO_URL=https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.302-1/virtio-win-0.1.302.iso
UBUNTU_URL=https://releases.ubuntu.com/26.04/ubuntu-26.04.1-live-server-amd64.iso
FEDORA_ISO=$MEDIA_DIR/Fedora-Everything-netinst-x86_64-45-1.4.iso
FEDORA_URL=https://dl.fedoraproject.org/pub/fedora/linux/releases/45/Everything/x86_64/iso/Fedora-Everything-netinst-x86_64-45-1.4.iso
FEDORA_SUMS_URL=https://dl.fedoraproject.org/pub/fedora/linux/releases/45/Everything/x86_64/iso/Fedora-Everything-45-1.4-x86_64-CHECKSUM

# --- domain ----------------------------------------------------------------
# Do not use .local: avahi/mDNS on the Ubuntu client takes that suffix.
DOMAIN=mld.contoso.com
NETBIOS=MLD
# Win2025 needs only Server 2025 DCs. Use WinThreshold (2016) to test older levels.
AD_LEVEL=Win2025
REGISTERED_OWNER=Contoso
GUEST_TZ=UTC
NTP_SERVERS="pool.ntp.org time.windows.com"

# --- DC VM -----------------------------------------------------------------
DC_VM=mld-dc
DC_HOSTNAME=DC1
DC_IP=10.110.0.2
NET_PREFIX=24
NET_GW=10.110.0.1
DC_VCPUS=4
DC_RAM_MB=6144
DC_DISK_GB=60
# install.wim index. The eval ISO has 1-4. 4 = Datacenter (Desktop Experience).
WIN_IMAGE_INDEX=4

# Windows password complexity applies.
ADMIN_PW=CHANGE-ME
DSRM_PW=CHANGE-ME
# FreeIPA Directory Manager (LDAP root) password. IDP=freeipa only.
IPA_DM_PW=CHANGE-ME

# --- AD content --------------------------------------------------------------
LAB_USERS="alice bob"
LAB_USER_PW=CHANGE-ME
LINUX_GROUP=LinuxUsers
# This account can only create and change computer objects in OU=Computers,OU=Linux. The clients do not get its
# password: they join with an offline domain join blob (djoin.exe /provision, ./build.sh client odj).
JOIN_USER=svc-join
JOIN_PW=CHANGE-ME
# 1 = the AD home \\DC\Homes$\<user> is mounted on /home/<user> at login (pam_mount, sec=krb5).
# 0 = local home on the client, made at the first login (pam_mkhomedir). The DC share stays.
CIFS_HOME=1
# 1 = the Homes$ share requires SMB encryption (cifs option seal).
SMB_ENCRYPT=1
# IDP=freeipa only. 1 = autofs mounts the NFSv4 home (sec=krb5p) of the IPA server on /home/mld/<user>.
# 0 = local home on the client.
NFS_HOME=1

# --- PKI (AD CS on the DC) --------------------------------------------------
# CA common name. No spaces: the DCOM request names the CA by this value.
CA_NAME=MLD-Lab-CA
# Machine certificate at first boot. IDP=windows: web (http certsrv), dcom (ICertRequestD) or none.
# IDP=freeipa: ipa (certmonger and the IPA CA) or none. Empty = web with windows, ipa with freeipa.
# The private key is made in the TPM and never leaves it.
PKI_ENROLL=
# PIN of the machine TPM token (mld-machine), the same on all clients. Not a secret: only root can read the token store.
# The snx-rs VPN client uses the machine certificate with this PIN (cert-password), without a prompt.
# Letters, digits, ".", "_" and "-" only.
MACHINE_TOKEN_PIN=mld-machine

# --- client VM ---------------------------------------------------------------
CLIENT_VM=mld-client
CLIENT_HOSTNAME=lnx01
# ./build.sh net puts CLIENT_MAC -> CLIENT_IP in the DHCP host entry. DHCP range: .100-.254 of the DC subnet.
CLIENT_MAC=52:54:00:6d:6c:14
CLIENT_IP=10.110.0.20
CLIENT_VCPUS=4
CLIENT_RAM_MB=8192
CLIENT_DISK_GB=40

# Local admin account on the client (not in AD).
CLIENT_ADMIN=labadmin
CLIENT_ADMIN_PW=CHANGE-ME

# LUKS2 passphrase. The client always has this keyslot.
LUKS_PASSPHRASE=CHANGE-ME
# 1 = first boot enrolls a TPM2 keyslot bound to the PCRs in TPM2_PCRS. PCR 7 = Secure Boot state.
ENROLL_TPM2=0
TPM2_PCRS=7
# 1 = boot a signed unified kernel image (UKI). build.sh makes a lab signing key (.stage/sb).
# The kernel, initrd and command line are in the signed UKI, so PCR 7 then also covers them.
# Secure Boot stays on. shim + grub stay as the second boot entry.
UKI=0
# How the firmware trusts the UKI (only with UKI=1):
# db  = build.sh adds the lab certificate to the client NVRAM db. The firmware starts the UKI. Needs virt-fw-vars.
# mok = the firmware keys stay as delivered (Microsoft only). shim starts the UKI and checks it against the MOK list.
#       ./build.sh client mok-enroll requests the MOK and confirms it in MokManager on the serial console.
UKI_TRUST=db
# Password for the MOK confirmation in MokManager (UKI_TRUST=mok). ASCII only: console.py types it on the serial console.
MOK_PASSWORD=CHANGE-ME
# Physical FIDO2 key for passthrough, vendor:product from lsusb, for example 1050:0407. Empty = no FIDO2.
FIDO2_HOSTDEV=
# Client PIN of the FIDO2 key. Empty = enroll without a PIN.
FIDO2_PIN=

# Desktop of the client: gnome (ubuntu-desktop-minimal, GDM) or kde (kde-plasma-desktop, SDDM). The install puts one on the
# client. To change it on a built client, build the client again: client resume does not swap the desktop.
CLIENT_DE=gnome
# Logo of the boot screen (Plymouth) and the login screen: PNG or SVG, light on a dark background, about 480x140 pixels.
# Empty = client/mld/brand/logo.svg. A change goes to a built client with client resume (the initrd is made again).
BRAND_LOGO=
# Background color of the boot and login screen, #rrggbb.
BRAND_BG=#1e3a5f
# 1 = install the snx-rs Check Point VPN client from the upstream APT repository (key in client/mld/vpn/snx-rs.sources).
# The install makes no VPN profile. 0 = remove snx-rs (client resume).
SNX_RS=1
# 1 = launchers for the Microsoft 365 web apps (menu, dock, desktop). Empty = 1 with IDP=windows, 0 with IDP=freeipa.
O365_APPS=
