# Plymouth theme "mld": the two-step module of the Ubuntu spinner theme, with the logo (watermark.png) and BRAND_BG.
# mld-firstboot (phase_brand) replaces BRAND_BG_HEX and copies the spinner images into the theme folder.
[Plymouth Theme]
Name=MLD
Description=Managed Linux Desktop boot screen
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
ImageDir=/usr/share/plymouth/themes/mld
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.6
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.75
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.4
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0xBRAND_BG_HEX
BackgroundEndColor=0xBRAND_BG_HEX
ProgressBarBackgroundColor=0x606060
ProgressBarForegroundColor=0xffffff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer
